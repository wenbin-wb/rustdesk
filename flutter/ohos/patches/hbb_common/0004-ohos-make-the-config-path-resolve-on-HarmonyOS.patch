     }
 
     pub fn path<P: AsRef<Path>>(p: P) -> PathBuf {
-        #[cfg(any(target_os = "android", target_os = "ios"))]
+        // HarmonyOS joins this arm for the same reason as get_home, but it uses APP_DIR:
+        // on these platforms the config lives in the application's own data directory, which
+        // mainInit supplies. The fallback below resolves it through ProjectDirs, which has no
+        // entry for ohos and yields an empty path -- and every config file the core wrote
+        // would then land in the process working directory.
+        #[cfg(any(target_os = "android", target_os = "ios", target_env = "ohos"))]
         {
             let mut path: PathBuf = APP_DIR.read().unwrap().clone().into();
             path.push(p);
             return path;
         }
-        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        #[cfg(not(any(target_os = "android", target_os = "ios", target_env = "ohos")))]
         {
             #[cfg(not(target_os = "macos"))]
             let org = "".to_owned();
@@ -1017,12 +1027,15 @@ impl Config {
         std::cmp::max(CONFIG2.read().unwrap().serial, SERIAL)
     }
 
