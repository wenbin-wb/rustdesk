From c2ee6ac3cb87bb34419f6bb65e6d4a9084f63d9e Mon Sep 17 00:00:00 2001
From: wenbin <wenbin_mj@163.com>
Date: Fri, 11 Sep 2026 01:30:41 +0800
Subject: [PATCH 4/4] ohos: make the config path resolve on HarmonyOS

Config::path() and Config::get_home() both listed only android and ios in their
platform arms, so HarmonyOS -- which is target_os = "linux" with target_env = "ohos" --
took the desktop fallback in each:

  path()      resolves through ProjectDirs, which has no entry for ohos and yields an
              empty path, so every config file the core wrote landed in the process
              working directory
  get_home()  resolves through dirs_next::home_dir(), which the sandbox has no useful
              value for

Both are now in the same arm as android and ios: path() uses APP_DIR, which mainInit
supplies, and get_home() uses APP_HOME_DIR, which mainSetHomeDir supplies. The ohos build
already declared APP_HOME_DIR, so the declaration was there and nothing read it.

Consequence worth noting, because it explains a symptom that looked like something else:
Config::get_id() generates a random id when the stored one is empty and then persists it
through set_id. With path() unresolvable the write went nowhere, so every process start
generated a fresh id -- which is why the device id shown in the app changed on every
launch.

gen_id() is moved into the mobile arm as well. It is the same class of omission: on ohos it
was taking the desktop branch, which consults the hostname-as-id option and calls
whoami::hostname(). That branch happens to fall through to get_auto_id() when the option is
off, so it was not producing a wrong id, but a mobile platform has no user-set hostname to
offer and should not be reading that option.
---
 src/config.rs | 25 +++++++++++++++++++------
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/src/config.rs b/src/config.rs
index a8f70ba..7416b54 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -763,9 +763,14 @@ impl Config {
     /// where an attacker can manipulate the environment variable to inject malicious
     /// paths into privileged operations.
     pub fn get_home() -> PathBuf {
-        #[cfg(any(target_os = "android", target_os = "ios"))]
+        // HarmonyOS joins this arm: get_home must return the directory the application set
+        // through mainSetHomeDir, not a home directory looked up from the environment. The
+        // sandbox has no meaningful $HOME, and dirs_next would return something the app
+        // cannot write to. Without this the APP_HOME_DIR that the ohos build declares is
+        // never read.
+        #[cfg(any(target_os = "android", target_os = "ios", target_env = "ohos"))]
         return PathBuf::from(APP_HOME_DIR.read().unwrap().as_str());
-        #[cfg(not(any(target_os = "android", target_os = "ios")))]
+        #[cfg(not(any(target_os = "android", target_os = "ios", target_env = "ohos")))]
         {
             if let Some(path) = dirs_next::home_dir() {
                 patch(path)
