From b91106e708d02799f989f533145f45340844f03a Mon Sep 17 00:00:00 2001
From: wenbin <wenbin_mj@163.com>
Date: Thu, 10 Sep 2026 17:48:43 +0800
Subject: [PATCH 1/3] ohos: exclude machine-uid/mac_address/default_net from
 the ohos target

The HarmonyOS build (target_env = ohos) is a mobile client, like android/ios. These desktop-only crates either fail to build for the target (machine-uid's build.rs compiles win.cpp based on the HOST cfg) or have no HarmonyOS equivalent. Extend the existing mobile cfg gates with target_env = ohos and fall back to the same behaviour the other mobile targets use.

- Cargo.toml: drop mac_address/default_net/machine-uid for ohos
- lib.rs: gate the mac_address/machine_uid re-exports and get_uuid()
- fingerprint.rs: use the zeroed addr like the other mobile targets
- config.rs: get_auto_id() falls back to a random id like android/ios
---
 Cargo.toml         | 2 +-
 src/config.rs      | 4 ++--
 src/fingerprint.rs | 4 ++--
 src/lib.rs         | 6 +++---
 4 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 8e17356..33bacb2 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -71,7 +71,7 @@ async-recursion = "1.1"
 webrtc = { version = "0.13.0", optional = true }
 libloading = "0.8"
 
-[target.'cfg(not(any(target_os = "android", target_os = "ios")))'.dependencies]
+[target.'cfg(not(any(target_os = "android", target_os = "ios", target_env = "ohos")))'.dependencies]
 mac_address = "1.1"
 default_net = { git = "https://github.com/rustdesk-org/default_net" }
 machine-uid = { git = "https://github.com/rustdesk-org/machine-uid" }
